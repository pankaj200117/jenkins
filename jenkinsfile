pipeline {
    agent any

    stages {
        stage("Code Checkout") {
            steps {
                // Corrected Git URL
                git url: "https://github.com/pankaj200117/jenkins.git", branch: "main"
            }
        }
        stage("Build & Test") {
            steps {
                sh "docker build . -t flaskapp"
            }
        }
        stage("Push to DockerHub") {
            environment {
                // Define your DockerHub credentials ID here
                dockerHub = credentials('dockerHub') // Ensure this ID exists in Jenkins credentials store
            }
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', dockerHub) {
                        // Ensure correct DockerHub username in the tag
                        sh "docker tag flaskapp ${dockerHub.username}/flaskapp:latest"
                        sh "docker push ${dockerHub.username}/flaskapp:latest"
                    }
                }
            }
        }
        stage("Deploy") {
            steps {
                // Make sure docker-compose.yml exists in the directory
                sh "docker-compose down && docker-compose up -d"
            }
        }
    }
}
